# Host folder mounted live at /workspace/folder-server in the container
DATASET_DIR=./folder-server
# auto | cpu | cuda
DATAVIZ_DEVICE=auto
# Where relative config paths start (storage.allowed_roots '.', dataset.workspace_root). Default: this folder, or two
# levels up when it sits in a bigger project as scripts/image-tools/ (as in the Docker image).
# DATAVIZ_PROJECT_ROOT=
# Optional Hugging Face token (silences the "unauthenticated requests" notice, faster downloads)
# HF_TOKEN=

# ---- PostgreSQL + accounts (required) ----
# Password of the bundled PostgreSQL (user and database: dataviz). Reachable from this host at 127.0.0.1:${PG_PORT}.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# PG_PORT=15432
# Encrypts the passwords / API keys users save (S3, FTP, databases, LLM providers, model servers). Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it with your database backups: without it the stored secrets cannot be read. Rotate: NEW,OLD (comma-separated).
# Empty = a key is generated into the cache volume (.dataviz_cache/secret.key) on first start.
DATAVIZ_SECRET_KEY=
# The first admin, created on the first start when there is no admin yet (change the password after signing in).
# Empty password = a random one is printed once in the container log (docker logs image-tools).
DATAVIZ_ADMIN_USERNAME=admin
DATAVIZ_ADMIN_EMAIL=admin@localhost
DATAVIZ_ADMIN_PASSWORD=admin123
# true = every start makes DATAVIZ_ADMIN_USERNAME an active admin with DATAVIZ_ADMIN_PASSWORD (even after the first start;
# signs that admin out everywhere). false = only the first start reads the three lines above.
DATAVIZ_ADMIN_RESET=false
# auto = Secure cookies when the page is served over https (also behind a proxy sending X-Forwarded-Proto); true | false
# DATAVIZ_COOKIE_SECURE=auto

# Which compose files `docker compose` uses. Unset = docker-compose.yml only (portable CPU default).
#   GPU server:        COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#   the persistent-path server (/home/jovyan/work):
#                      COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.server.yml
# COMPOSE_FILE=docker-compose.yml

# Build on top of an earlier image-tools build so `docker compose up -d --build` does not reinstall torch every time:
#   docker tag image-tools:latest image-tools:torch-base
# BASE_IMAGE=image-tools:torch-base
